@router.get("/{scan_id}/pages")
def get_scan_document_pages(
    scan_id: UUID,
    db: Session = Depends(get_db),
    current_user: User = Depends(
        require_roles("ADMIN", "INSTRUCTOR")
    ),
):
    """Return the extracted text of every page in a scan."""

    scan = (
        db.query(Scan)
        .filter(Scan.id == scan_id)
        .first()
    )

    if scan is None:
        raise HTTPException(
            status_code=404,
            detail="Scan not found.",
        )

    if not can_access_scan(
        db=db,
        scan=scan,
        current_user=current_user,
    ):
        raise HTTPException(
            status_code=403,
            detail="You do not have permission to access this scan.",
        )

    pages = (
        db.query(ScanPage)
        .filter(ScanPage.scan_id == scan.id)
        .order_by(ScanPage.page_number.asc())
        .all()
    )
    page_data = [
        {
            "page_number": page.page_number,
            "raw_text": page.raw_text,
        }
        for page in pages
    ]
    if not any(item["raw_text"].strip() for item in page_data):
        source_path = Path(scan.file_path)
        if not source_path.is_file():
            raise HTTPException(
                status_code=404,
                detail="Extracted pages are missing and the original scan file is unavailable.",
            )
        try:
            extracted_pages = process_extracted_pages(source_path)
        except (OSError, ValueError) as exc:
            raise HTTPException(
                status_code=422,
                detail=f"Could not re-extract text from the original scan file: {exc}",
            ) from exc
        page_data = [
            {
                "page_number": page["page_number"],
                "raw_text": page["raw_text"],
            }
            for page in extracted_pages
        ]
        if not any(item["raw_text"].strip() for item in page_data):
            raise HTTPException(
                status_code=422,
                detail="No extractable text was found in the original scan file.",
            )

    return {
        "scan_id": str(scan.id),
        "pages": page_data,
    }

