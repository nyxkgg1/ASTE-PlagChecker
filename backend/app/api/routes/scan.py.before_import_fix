@router.get("")
def list_scans(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    """List scans visible to the logged-in user."""
    roles = get_user_roles(db=db, user=current_user)

    query = db.query(Scan)

    if "ADMIN" not in roles:
        if not ({"INSTRUCTOR", "STUDENT_OFFICER"} & set(roles)):
            raise HTTPException(
                status_code=403,
                detail="You do not have permission to view scans.",
            )

        query = query.filter(
            (Scan.owner_id == current_user.id)
            | (
                Scan.owner_id.is_(None)
                & (Scan.scanned_by == current_user.id)
            )
        )

    scans = query.order_by(Scan.created_at.desc()).all()
    results = []
    titles = {scan.title for scan in scans if scan.title}
    request_status_by_title: dict[str, str] = {}
    request_status_by_scan_id: dict[str, str] = {}

    if titles:
        instructor_user_ids = (
            db.query(UserRole.user_id)
            .join(Role, Role.id == UserRole.role_id)
            .filter(Role.role_name == "INSTRUCTOR")
        )
        requests = (
            db.query(DocumentRequest)
            .filter(
                DocumentRequest.request_type == "ADD",
                DocumentRequest.title.in_(titles),
                DocumentRequest.requested_by.in_(instructor_user_ids),
            )
            .order_by(
                DocumentRequest.created_at.desc(),
                DocumentRequest.id.desc(),
            )
            .all()
        )
        for request in requests:
            request_status_by_title.setdefault(
                request.title,
                request.status,
            )
            if request.scan_id:
                request_status_by_scan_id.setdefault(
                    str(request.scan_id),
                    request.status,
                )

    for scan in scans:
        item = build_scan_response(scan).dict()
        item["reference_request_status"] = (
            request_status_by_scan_id.get(str(scan.id))
            or request_status_by_title.get(scan.title)
        )

        # Certificate information
        certificate = (
            db.query(Certificate)
            .filter(Certificate.scan_id == scan.id)
            .first()
        )

        item["certificate_generated"] = certificate is not None
        item["certificate_number"] = (
            certificate.certificate_number if certificate else None
        )
        item["certificate_id"] = (
            str(certificate.id) if certificate else None
        )

        # Approval fields are not yet connected to an identified
        # approval record in the database.
        item["approval_status"] = scan.approval_status
        item["admin_approval_date"] = (
            scan.admin_approval_date.isoformat()
            if scan.admin_approval_date
            else None
        )
        item["reviewed_by"] = (
            str(scan.reviewed_by)
            if scan.reviewed_by
            else None
        )
        item["admin_comments"] = scan.admin_comments

        # Latest plagiarism analysis
        analysis = (
            db.query(PlagiarismAnalysis)
            .filter(PlagiarismAnalysis.scan_id == scan.id)
            .order_by(
                PlagiarismAnalysis.created_at.desc(),
                PlagiarismAnalysis.id.desc(),
            )
            .first()
        )

        similarity = (
            float(analysis.overall_similarity)
            if analysis and analysis.overall_similarity is not None
            else None
        )

        # The UI expects a percentage. Convert fractional scores
        # such as 0.25 to 25, but preserve scores already in 0–100.
        if similarity is not None and 0 <= similarity <= 1:
            similarity *= 100

        item["plagiarism_score"] = similarity
        item["ai_score"] = None

        results.append(item)

    return results


