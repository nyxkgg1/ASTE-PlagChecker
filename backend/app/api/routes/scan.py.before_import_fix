def get_user_roles(
    db: Session,
    user: User,
) -> list[str]:
    """
    Return role names assigned to the user.
    """

    user_roles = (
        db.query(UserRole)
        .filter(
            UserRole.user_id == user.id
        )
        .all()
    )

    return [
        user_role.role.role_name
        for user_role in user_roles
        if user_role.role is not None
    ]

def can_access_scan(
    db: Session,
    scan: Scan,
    current_user: User,
) -> bool:
    """
    Admins can access all scans.
    Instructors and Student Officers can access only their own scans.
    Other roles cannot access scans.
    """

    roles = get_user_roles(
        db=db,
        user=current_user,
    )

    if "ADMIN" in roles:
        return True

    if not (
        {"INSTRUCTOR", "STUDENT_OFFICER"}
        & set(roles)
    ):
        return False

    # Prefer owner_id; use scanned_by for legacy scans
    # that do not have an owner_id.
    owner_id = scan.owner_id or scan.scanned_by

    return owner_id == current_user.id
def build_scan_response(
    scan: Scan,
) -> ScanResponse:
    """
    Convert Scan database object into ScanResponse.
    """

    return ScanResponse(
        id=str(scan.id),
        title=scan.title,
        file_name=scan.file_name,
        file_size=scan.file_size,
        mime_type=scan.mime_type,
        sha256_hash=scan.sha256_hash,
        status=scan.status,
        owner_id=(
            str(scan.owner_id)
            if scan.owner_id
            else None
        ),
        scanned_by=str(scan.scanned_by),
        created_at=scan.created_at.isoformat(),
        completed_at=(
            scan.completed_at.isoformat()
            if scan.completed_at
            else None
        ),
    )


