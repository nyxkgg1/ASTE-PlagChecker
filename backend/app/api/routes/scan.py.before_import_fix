@router.post("/preview")
async def preview_scan_document(
    document: UploadFile = File(...),
    current_user: User = Depends(
        require_roles("ADMIN", "INSTRUCTOR")
    ),
):
    file_path: Path | None = None
    try:
        file_path, _, _, _ = await save_scan_file(document)
        pages = process_extracted_pages(file_path)
        selection = extract_selectable_paragraphs(pages)
        if not selection["paragraphs"]:
            raise HTTPException(
                status_code=422,
                detail="No selectable paragraphs were found in this document.",
            )
        return {
            "paragraphs": selection["paragraphs"],
            "default_selected_ids": selection["default_selected_ids"],
            "is_fter": selection["is_fter"],
        }
    except HTTPException:
        raise
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Failed to preview uploaded document: {exc}",
        ) from exc
    finally:
        if file_path is not None:
            file_path.unlink(missing_ok=True)
def run_plagiarism_in_isolated_session(
    scan_id: UUID,
    initiated_by: UUID,
) -> str:
    db = SessionLocal()

    try:
        analysis = save_plagiarism_analysis(
            db=db,
            scan_id=scan_id,
            initiated_by=initiated_by,
        )

        db.commit()

        return analysis.status

    except Exception:
        logger.exception(
            "Plagiarism analysis failed for scan %s",
            scan_id,
        )

        db.rollback()
        db.close()

        # Persist FAILED independently because the original
        # transaction was rolled back.
        failure_db = SessionLocal()

        try:
            failed_analysis = PlagiarismAnalysis(
                scan_id=scan_id,
                initiated_by=initiated_by,
                status="FAILED",
                algorithm_version=ALGORITHM_VERSION,
                completed_at=datetime.now(timezone.utc),
            )

            failure_db.add(failed_analysis)
            failure_db.commit()

        except Exception:
            failure_db.rollback()
            logger.exception(
                "Could not persist plagiarism failure for scan %s",
                scan_id,
            )

        finally:
            failure_db.close()

        return "FAILED"

    finally:
        db.close()
def run_ai_detection_in_isolated_session(
    scan_id: UUID,
    initiated_by: UUID,
) -> str:
    db = SessionLocal()

    try:
        run = run_ai_analysis(
            db,
            scan_id=scan_id,
            initiated_by=initiated_by,
        )

        db.commit()

        return run.status

    except Exception:
        logger.exception(
            "AI detection failed for scan %s",
            scan_id,
        )

        db.rollback()

        # Persist the failed run independently because the
        # original analysis transaction has been rolled back.
        failure_db = SessionLocal()

        try:
            failed_run = AIAnalysisRun(
                scan_id=scan_id,
                initiated_by=initiated_by,
                status="FAILED",
                completed_at=datetime.now(timezone.utc),
            )

            failure_db.add(failed_run)
            failure_db.commit()

        except Exception:
            failure_db.rollback()

            logger.exception(
                "Could not persist AI detection failure for scan %s",
                scan_id,
            )

        finally:
            failure_db.close()

        return "FAILED"

    finally:
        db.close()

@router.post(
    "",
    response_model=ScanResponse,
)
async def create_scan(
    title: str = Form(...),
    document: UploadFile = File(...),
    destination_folder: str = Form(""),
    scan_mode: str = Form("complete"),
    selected_paragraph_ids: str | None = Form(None),
    db: Session = Depends(get_db),
    current_user: User = Depends(
        require_roles(
            "ADMIN",
            "INSTRUCTOR",
        )
    ),
):
    """
    Upload a document, extract its contents,
    create scan sentences and run plagiarism analysis.
    """
    if scan_mode not in {"complete", "selective"}:
        raise HTTPException(
            status_code=400,
            detail="Scan mode must be 'complete' or 'selective'.",
        )
    requested_paragraph_ids: list[str] | None = None
    if selected_paragraph_ids is not None:
        try:
            parsed_ids = json.loads(selected_paragraph_ids)
        except json.JSONDecodeError as exc:
            raise HTTPException(
                status_code=400,
                detail="Selected paragraph IDs must be a JSON array.",
            ) from exc
        if (
            not isinstance(parsed_ids, list)
            or any(not isinstance(item, str) or not item for item in parsed_ids)
            or len(parsed_ids) != len(set(parsed_ids))
            or not parsed_ids
        ):
            raise HTTPException(
                status_code=400,
                detail="Select at least one valid paragraph.",
            )
        requested_paragraph_ids = parsed_ids
    if scan_mode == "selective" and requested_paragraph_ids is None:
        raise HTTPException(
            status_code=400,
            detail="Choose the report paragraphs to scan.",
        )

    # --------------------------------------------------------
    # Save uploaded file
    # --------------------------------------------------------

    try:
        (
            file_path,
            file_size,
            sha256_hash,
            extension,
        ) = await save_scan_file(
                document,
                destination_folder=destination_folder,
            )

    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=str(exc),
        )

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Failed to save uploaded document: {exc}",
        )

    # --------------------------------------------------------
    # Determine MIME type
    # --------------------------------------------------------

    mime_type = (
        document.content_type
        or "application/octet-stream"
    )

    # --------------------------------------------------------
    # Create Scan record
    # --------------------------------------------------------

    scan = Scan(
        title=title,
        file_name=document.filename or f"document{extension}",
        file_path=str(file_path),
        file_size=file_size,
        mime_type=mime_type,
        sha256_hash=sha256_hash,
        status="PROCESSING",
        owner_id=current_user.id,
        scanned_by=current_user.id,
    )

    db.add(scan)
    base_transaction_committed = False
    try:
        db.flush()

        # ----------------------------------------------------
        # Extract document pages
        # ----------------------------------------------------

        processed_pages = process_extracted_pages(
            file_path
        )
        selection = extract_selectable_paragraphs(processed_pages)
        if not selection["paragraphs"]:
            raise HTTPException(
                status_code=422,
                detail="No body paragraphs were found in this document.",
            )
        available_ids = {
            paragraph["id"] for paragraph in selection["paragraphs"]
        }
        if requested_paragraph_ids is not None:
            unknown_ids = set(requested_paragraph_ids) - available_ids
            if unknown_ids:
                raise HTTPException(
                    status_code=400,
                    detail="The selected paragraphs do not match this document preview. Preview the document again.",
                )

        selected_ids = (
            set(requested_paragraph_ids)
            if scan_mode == "selective" and requested_paragraph_ids is not None
            else {
                paragraph["id"]
                for paragraph in selection["paragraphs"]
                if not paragraph.get("is_front_matter", False)
            }
        )
        selected_paragraphs = [
            paragraph
            for paragraph in selection["paragraphs"]
            if paragraph["id"] in selected_ids
        ]

        section_by_group: dict[str, ScanSection] = {}
        leaf_section_by_paragraph: dict[str, ScanSection] = {}
        for section_order, paragraph in enumerate(selected_paragraphs, start=1):
            group_id = paragraph.get("parent_section_id") or paragraph["section_id"]
            group_title = (
                paragraph.get("parent_section_title")
                or paragraph["section_title"]
            )
            if group_id not in section_by_group:
                section = ScanSection(
                    scan_id=scan.id,
                    section_title=group_title,
                    normalized_title=group_title.casefold(),
                    section_level=1,
                    section_order=section_order,
                    page_start=paragraph["page_number"],
                    page_end=paragraph["page_number"],
                )
                db.add(section)
                db.flush()
                section_by_group[group_id] = section

            parent = section_by_group[group_id]
            parent.page_end = max(
                parent.page_end or paragraph["page_number"],
                paragraph["page_number"],
            )
            leaf = ScanSection(
                scan_id=scan.id,
                parent_section_id=parent.id,
                section_title=paragraph["label"],
                normalized_title=paragraph["label"].casefold(),
                section_level=2,
                section_order=section_order,
                page_start=paragraph["page_number"],
                page_end=paragraph["page_number"],
            )
            db.add(leaf)
            db.flush()
            leaf_section_by_paragraph[paragraph["id"]] = leaf

        paragraphs_by_page: defaultdict[int, list[dict]] = defaultdict(list)
        for paragraph in selected_paragraphs:
            paragraphs_by_page[int(paragraph["page_number"])].append(paragraph)

        # ----------------------------------------------------
        # Create pages and sentences
        # ----------------------------------------------------

        for processed_page in processed_pages:

            scan_page = ScanPage(
                scan_id=scan.id,
                page_number=processed_page[
                    "page_number"
                ],
                raw_text=processed_page[
                    "raw_text"
                ],
                #normalized_text=processed_page[
                   # "normalized_text"
                #],
            )

            db.add(scan_page)

            db.flush()

            # ------------------------------------------------
            # Process sentences on this page
            # ------------------------------------------------

            sentence_index = 0
            for paragraph in paragraphs_by_page.get(
                int(processed_page["page_number"]),
                [],
            ):
                for sentence_data in process_page_sentences(paragraph["text"]):
                    sentence_index += 1
                    db.add(
                        ScanSentence(
                            scan_id=scan.id,
                            page_id=scan_page.id,
                            section_id=leaf_section_by_paragraph[
                                paragraph["id"]
                            ].id,
                            sentence_index=sentence_index,
                            raw_text=sentence_data["raw_text"],
                            normalized_text=sentence_data["normalized_text"],
                            token_count=sentence_data["token_count"],
                        )
                    )

        db.flush()

        # Save identifiers before committing the scan transaction.
        scan_id = scan.id
        initiated_by = current_user.id

        # ----------------------------------------------------
        # Mark extraction completed
        # ----------------------------------------------------

        scan.status = "COMPLETED"
        scan.completed_at = datetime.now(timezone.utc)

        # ----------------------------------------------------
        # Audit log
        # ----------------------------------------------------

        create_audit_log(
            db=db,
            user_id=current_user.id,
            action="SCAN_CREATED",
            entity_type="SCAN",
            entity_id=scan.id,
            new_values={
                "title": scan.title,
                "file_name": scan.file_name,
            },
        )

        # ----------------------------------------------------
        # Commit scan, pages, sections and sentences
        # ----------------------------------------------------

        db.commit()
        base_transaction_committed = True

        db.refresh(scan)

        # ----------------------------------------------------
        # Run plagiarism and AI detection concurrently
        # ----------------------------------------------------

        plagiarism_status, ai_status = await asyncio.gather(
            asyncio.to_thread(
                run_plagiarism_in_isolated_session,
                scan_id,
                initiated_by,
            ),
            asyncio.to_thread(
                run_ai_detection_in_isolated_session,
                scan_id,
                initiated_by,
            ),
            return_exceptions=True,
        )

        # Defensive handling in case a worker raises unexpectedly.
        if isinstance(plagiarism_status, BaseException):
            logger.error(
                "Unexpected plagiarism worker exception for scan %s: %s",
                scan_id,
                plagiarism_status,
            )
            plagiarism_status = "FAILED"

        if isinstance(ai_status, BaseException):
            logger.error(
                "Unexpected AI worker exception for scan %s: %s",
                scan_id,
                ai_status,
            )
            ai_status = "FAILED"

        logger.info(
            "Scan %s analysis results: plagiarism=%s, ai=%s",
            scan_id,
            plagiarism_status,
            ai_status,
        )

        return build_scan_response(scan)

    except HTTPException:
        db.rollback()

        # Delete the upload only if the base scan transaction
        # was never committed.
        if not base_transaction_committed:
            try:
                Path(file_path).unlink(missing_ok=True)
            except Exception:
                logger.exception(
                    "Could not delete uploaded file: %s",
                    file_path,
                )

        raise

    except Exception as exc:
        db.rollback()

        # Never delete a file belonging to a committed scan.
        if not base_transaction_committed:
            try:
                Path(file_path).unlink(missing_ok=True)
            except Exception:
                logger.exception(
                    "Could not delete uploaded file: %s",
                    file_path,
                )

        logger.exception(
            "Failed to process scan"
        )

        raise HTTPException(
            status_code=500,
            detail=f"Failed to process scan: {exc}",
        ) from exc


