@router.get(
    "/{scan_id}/plagiarism/report",
    response_model=PlagiarismReportResponse,
)
def get_plagiarism_report(
    scan_id: str,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    # ========================================================
    # VALIDATE SCAN ID
    # ========================================================

    try:
        scan_uuid = UUID(scan_id)
    except ValueError:
        raise HTTPException(
            status_code=400,
            detail="Invalid scan_id.",
        )

    # ========================================================
    # FIND SCAN
    # ========================================================

    scan = (
        db.query(Scan)
        .filter(Scan.id == scan_uuid)
        .first()
    )

    if not scan:
        raise HTTPException(
            status_code=404,
            detail="Scan not found.",
        )

    # ========================================================
    # CHECK ACCESS
    # ========================================================

    if not can_access_scan(
        db=db,
        scan=scan,
        current_user=current_user,
    ):
        raise HTTPException(
            status_code=403,
            detail="You do not have access to this scan.",
        )

    # ========================================================
    # FIND COMPLETED PLAGIARISM ANALYSIS
    # ========================================================

    analysis = (
        db.query(PlagiarismAnalysis)
        .filter(
            PlagiarismAnalysis.scan_id == scan.id
        )
        .order_by(
            ScanPage.page_number.asc(),
            PlagiarismAnalysis.created_at.desc()
        )
        .first()
    )

    if not analysis:
        raise HTTPException(
            status_code=404,
            detail="Plagiarism analysis not found.",
        )

    # ========================================================
    # LOAD SCAN SENTENCES
    # ========================================================

    scan_sentences = (
        db.query(ScanSentence)
        .options(
            joinedload(ScanSentence.page)
        )
        .filter(
            ScanSentence.scan_id == scan.id
        )
        .order_by(
            ScanPage.page_number.asc(),
            ScanSentence.sentence_index.asc()
        )
        .all()
    )

    # ========================================================
    # LOAD MATCHES
    # ========================================================

    matches = (
        db.query(PlagiarismMatch)
        .options(
            joinedload(
                PlagiarismMatch.reference_sentence
            ).joinedload(
                ReferenceSentence.reference_document
            ),
            joinedload(
                PlagiarismMatch.scan_sentence
            ).joinedload(
                ScanSentence.page
            ),
        )
        .filter(
            PlagiarismMatch.analysis_id
            == analysis.id
        )
        .order_by(
            PlagiarismMatch.created_at.asc()
        )
        .all()
    )

    # ========================================================
    # GROUP MATCHES BY SCAN SENTENCE
    # ========================================================

    matches_by_sentence: dict[
        UUID,
        list[PlagiarismMatch]
    ] = {}

    for match in matches:
        matches_by_sentence.setdefault(
            match.scan_sentence_id,
            [],
        ).append(match)

    # ========================================================
    # SENTENCE STATISTICS
    # ========================================================

    total_sentences = len(scan_sentences)

    matched_sentence_ids = set(
        matches_by_sentence.keys()
    )

    matched_sentences = len(
        matched_sentence_ids
    )

    unmatched_sentences = (
        total_sentences
        - matched_sentences
    )

    sentence_coverage_percentage = (
        (
            matched_sentences
            / total_sentences
        )
        * 100
        if total_sentences
        else 0.0
    )

    # ========================================================
    # TEXT COVERAGE
    #
    # Only sentences with actual persisted matches
    # contribute to matched text.
    # ========================================================

    total_text_length = sum(
        len(sentence.raw_text or "")
        for sentence in scan_sentences
    )

    matched_text_length = sum(
        len(
            scan_sentence.raw_text
            or ""
        )
        for scan_sentence in scan_sentences
        if scan_sentence.id
        in matched_sentence_ids
    )

    text_coverage_percentage = (
        (
            matched_text_length
            / total_text_length
        )
        * 100
        if total_text_length
        else 0.0
    )

    # ========================================================
    # MATCH STRENGTH
    # ========================================================

    match_strength_values = [
        float(match.similarity_score)
        for match in matches
        if match.similarity_score is not None
    ]

    average_match_strength = (
        sum(match_strength_values)
        / len(match_strength_values)
        if match_strength_values
        else 0.0
    )

    # ========================================================
    # MATCH COUNTS
    # ========================================================

    exact_count = sum(
        1
        for match in matches
        if match.detection_method == "EXACT"
    )

    high_similarity_count = sum(
        1
        for match in matches
        if match.detection_method
        == "HIGH_SIMILARITY"
    )

    moderate_similarity_count = sum(
        1
        for match in matches
        if match.detection_method
        == "MODERATE_SIMILARITY"
    )

    low_similarity_count = sum(
        1
        for match in matches
        if match.detection_method
        == "LOW_SIMILARITY"
    )

    # ========================================================
    # BUILD MATCH RESPONSE
    # ========================================================

    match_responses = []

    for match in matches:

        reference_sentence = (
            match.reference_sentence
        )

        reference_document = (
            reference_sentence.reference_document
            if reference_sentence
            else None
        )

        scan_sentence = (
            match.scan_sentence
        )

        match_responses.append(
            PlagiarismMatchResponse(
                id=str(match.id),

                sentence_index=(
                    scan_sentence.sentence_index
                    if scan_sentence
                    else 0
                ),

                scan_page_number=(
                    scan_sentence.page.page_number
                    if scan_sentence
                    and scan_sentence.page
                    else match.scan_page_number
                ),

                match_type=(
                    match.detection_method
                ),

                similarity_score=float(
                    match.similarity_score
                ),

                source=(
                    reference_document.title
                    if reference_document
                    else "Unknown Source"
                ),

                reference_page_number=(
                    reference_sentence.page_number
                    if reference_sentence
                    else match.reference_page_number
                ),

                scan_text=(
                    scan_sentence.raw_text
                    if scan_sentence
                    else match.scan_text
                ),

                reference_text=(
                    reference_sentence.raw_text
                    if reference_sentence
                    else match.reference_text
                ),
            )
        )

    # ========================================================
    # UNMATCHED SENTENCES
    # ========================================================

    unmatched_sentence_responses = []

    for sentence in scan_sentences:

        if sentence.id in matched_sentence_ids:
            continue

        unmatched_sentence_responses.append(
            UnmatchedSentenceResponse(
                sentence_index=sentence.sentence_index,
                scan_page_number=(
                    sentence.page.page_number
                    if sentence.page
                    else None
                ),
                text=sentence.raw_text,
                token_count=sentence.token_count,
            )
        )

    # ========================================================
    # SOURCE SUMMARY
    # ========================================================

    source_groups: dict[
        str,
        list[float]
    ] = {}

    for match in matches:

        reference_sentence = (
            match.reference_sentence
        )

        reference_document = (
            reference_sentence.reference_document
            if reference_sentence
            else None
        )

        source_name = (
            reference_document.title
            if reference_document
            else "Unknown Source"
        )

        source_groups.setdefault(
            source_name,
            [],
        ).append(
            float(match.similarity_score)
        )

    source_summary = []

    for source_name, scores in source_groups.items():

        source_summary.append(
            PlagiarismSourceSummaryResponse(
                source=source_name,

                matched_sentences=len(scores),

                average_similarity=round(
                    sum(scores) / len(scores),
                    4,
                ),
            )
        )

    source_summary.sort(
        key=lambda item: item.matched_sentences,
        reverse=True,
    )

    # ========================================================
    # PAGE SUMMARY
    # ========================================================

    page_groups: dict[
        int,
        dict[str, int]
    ] = {}

    for sentence in scan_sentences:

        if not sentence.page:
            continue

        page_number = (
            sentence.page.page_number
        )

        if page_number not in page_groups:
            page_groups[page_number] = {
                "total": 0,
                "matched": 0,
            }

        page_groups[page_number]["total"] += 1

        if sentence.id in matched_sentence_ids:
            page_groups[page_number]["matched"] += 1

    page_summary = []

    for page_number, values in sorted(
        page_groups.items()
    ):

        page_sentence_count = values["total"]
        page_matched_count = values["matched"]

        page_coverage = (
            (
                page_matched_count
                / page_sentence_count
            )
            * 100
            if page_sentence_count
            else 0.0
        )

        page_summary.append(
            PlagiarismPageSummaryResponse(
                page_number=page_number,
                total_sentences=page_sentence_count,
                matched_sentences=page_matched_count,
                sentence_coverage_percentage=round(
                    page_coverage,
                    2,
                ),
            )
        )

    # ========================================================
    # ALGORITHM SCORES
    # ========================================================

    algorithm_scores = (
        PlagiarismAlgorithmScoresResponse(
            exact=analysis.exact_match_score,
            ngram=analysis.ngram_score,
            tfidf=analysis.tfidf_score,
            semantic=analysis.semantic_score,
            cross_encoder=analysis.cross_encoder_score,
        )
    )

    # ========================================================
    # STATISTICS
    # ========================================================

    statistics = (
        PlagiarismStatisticsResponse(
            total_sentences=total_sentences,

            matched_sentences=matched_sentences,

            unmatched_sentences=unmatched_sentences,

            sentence_coverage_percentage=round(
                sentence_coverage_percentage,
                2,
            ),

            text_coverage_percentage=round(
                text_coverage_percentage,
                2,
            ),

            average_match_strength=round(
                average_match_strength,
                4,
            ),
        )
    )

    # ========================================================
    # MATCH COUNTS
    # ========================================================

    match_counts = (
        PlagiarismMatchCountsResponse(
            exact=exact_count,

            high_similarity=(
                high_similarity_count
            ),

            moderate_similarity=(
                moderate_similarity_count
            ),

            low_similarity=low_similarity_count,
        )
    )

    # ========================================================
    # FINAL REPORT
    # ========================================================

    return PlagiarismReportResponse(
        scan_id=str(scan.id),

        analysis_id=str(analysis.id),

        document_title=scan.title,

        file_name=scan.file_name,

        scanned_by=str(
            scan.scanned_by
        ),

        scanned_on=(
            scan.created_at.isoformat()
        ),

        completed_on=(
            scan.completed_at.isoformat()
            if scan.completed_at
            else None
        ),

        status=analysis.status,

        overall_similarity=(
            float(analysis.overall_similarity)
            if analysis.overall_similarity
            is not None
            else None
        ),

        statistics=statistics,

        algorithm_scores=algorithm_scores,

        match_counts=match_counts,

        source_summary=source_summary,

        page_summary=page_summary,

        matches=match_responses,

        unmatched_sentences=(
            unmatched_sentence_responses
        ),
    )
@router.get(
    "/{scan_id}/plagiarism/sentences",
)
def get_plagiarism_sentences(
    scan_id: str,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    """
    Return sentence-level plagiarism results.

    This endpoint is designed for the frontend plagiarism
    highlighting and detailed evidence view.

    It returns:

        Scan Sentence
            |
            +-- Match status
            |
            +-- Match type
            |
            +-- Similarity score
            |
            +-- Reference document
            |
            +-- Reference sentence
            |
            +-- Reference page
            |
            +-- Character-level highlighting
    """

    # =========================================================
    # 1. Find scan
    # =========================================================

    scan = (
        db.query(Scan)
        .filter(
            Scan.id == scan_id
        )
        .first()
    )

    if not scan:
        raise HTTPException(
            status_code=404,
            detail="Scan not found.",
        )

    # =========================================================
    # 2. Check access permission
    # =========================================================

    if not can_access_scan(
        db,
        scan,
        current_user,
    ):
        raise HTTPException(
            status_code=403,
            detail=(
                "You do not have permission "
                "to access this scan."
            ),
        )

    # =========================================================
    # 3. Get latest plagiarism analysis
    # =========================================================

    analysis = (
        db.query(PlagiarismAnalysis)
        .filter(
            PlagiarismAnalysis.scan_id
            == scan.id
        )
        .order_by(
            PlagiarismAnalysis.created_at.desc()
        )
        .first()
    )

    if not analysis:
        raise HTTPException(
            status_code=404,
            detail="Plagiarism analysis not found.",
        )

    # =========================================================
    # 4. Load scan sentences
    # =========================================================

    scan_sentences = (
        db.query(ScanSentence)
        .join(
            ScanPage,
            ScanSentence.page_id == ScanPage.id,
        )
        .options(
            joinedload(ScanSentence.page),
            joinedload(ScanSentence.section).joinedload(
                ScanSection.parent_section
            ),
        )
        .filter(
            ScanSentence.scan_id
            == scan.id
        )
        .order_by(
            ScanPage.page_number.asc(),
            ScanSentence.sentence_index.asc(),
            ScanSentence.id.asc(),
        )
        .all()
    )

    # =========================================================
    # 5. Load plagiarism matches
    # =========================================================

    matches = (
        db.query(PlagiarismMatch)
        .options(
            joinedload(
                PlagiarismMatch.reference_sentence
            ).joinedload(
                ReferenceSentence.reference_document
            ),
            joinedload(
                PlagiarismMatch.scan_sentence
            ),
        )
        .filter(
            PlagiarismMatch.analysis_id
            == analysis.id
        )
        .all()
    )

    # =========================================================
    # 6. Group matches by scan sentence
    # =========================================================

    matches_by_sentence = {}

    for match in matches:

        sentence_id = str(
            match.scan_sentence_id
        )

        if sentence_id not in matches_by_sentence:
            matches_by_sentence[
                sentence_id
            ] = []

        matches_by_sentence[
            sentence_id
        ].append(match)

    # =========================================================
    # 7. Build sentence results
    # =========================================================

    sentence_results = []

    for scan_sentence in scan_sentences:

        sentence_id = str(
            scan_sentence.id
        )
        paragraph_section = scan_sentence.section
        parent_section = (
            paragraph_section.parent_section
            if paragraph_section
            else None
        )
        section_metadata = {
            "section_id": (
                str(parent_section.id)
                if parent_section
                else None
            ),
            "section_title": (
                parent_section.section_title
                if parent_section
                else None
            ),
            "paragraph_id": (
                str(paragraph_section.id)
                if paragraph_section
                else None
            ),
            "paragraph_title": (
                paragraph_section.section_title
                if paragraph_section
                else None
            ),
        }

        sentence_matches = (
            matches_by_sentence.get(
                sentence_id,
                [],
            )
        )

        # =====================================================
        # UNMATCHED SENTENCE
        # =====================================================

        if not sentence_matches:

            sentence_results.append(
                {
                    "sentence_id": sentence_id,
                    "sentence_index": (
                        scan_sentence.sentence_index
                    ),
                    "page_number": (
                        scan_sentence.page.page_number
                        if scan_sentence.page
                        else None
                    ),
                    "text": (
                        scan_sentence.raw_text
                    ),
                    "normalized_text": (
                        scan_sentence.normalized_text
                    ),
                    "token_count": (
                        scan_sentence.token_count
                    ),
                    **section_metadata,
                    "matched": False,
                    "match_count": 0,
                    "best_match": None,
                    "matches": [],
                    "highlighting": {
                        "segments": [
                            {
                                "text": (
                                    scan_sentence.raw_text
                                ),
                                "matched": False,
                            }
                        ],
                        "matched": False,
                        "matched_character_count": 0,
                        "total_character_count": len(
                            scan_sentence.raw_text
                        ),
                        "character_coverage_percentage": 0.0,
                    },
                }
            )

            continue

        # =====================================================
        # SORT MATCHES
        # =====================================================

        sorted_matches = sorted(
            sentence_matches,
            key=lambda item: (
                float(
                    item.similarity_score
                )
                if item.similarity_score
                is not None
                else 0.0
            ),
            reverse=True,
        )

        best_match = sorted_matches[0]

        # =====================================================
        # BUILD MATCH RESULTS
        # =====================================================

        match_results = []

        for match in sorted_matches:

            reference_sentence = (
                match.reference_sentence
            )

            reference_document = None

            if reference_sentence:
                reference_document = (
                    reference_sentence
                    .reference_document
                )

            source_name = None

            if reference_document:
                source_name = (
                    reference_document.title
                )

            reference_text = (
                reference_sentence.raw_text
                if reference_sentence
                else match.reference_text
            )

            # -------------------------------------------------
            # Character-level highlighting
            # -------------------------------------------------

            highlighting = generate_highlighting(
                scan_text=(
                    scan_sentence.raw_text
                ),
                reference_text=(
                    reference_text or ""
                ),
            )

            match_results.append(
                {
                    "match_id": str(
                        match.id
                    ),
                    "match_type": (
                        match.detection_method
                    ),
                    "similarity_score": (
                        float(
                            match.similarity_score
                        )
                        if match.similarity_score
                        is not None
                        else 0.0
                    ),
                    "source": source_name,
                    "reference_sentence_id": (
                        str(
                            reference_sentence.id
                        )
                        if reference_sentence
                        else None
                    ),
                    "reference_page_number": (
                        reference_sentence.page_number
                        if reference_sentence
                        else match.reference_page_number
                    ),
                    "reference_sentence_index": (
                        reference_sentence.sentence_index
                        if reference_sentence
                        else None
                    ),
                    "reference_text": (
                        reference_text
                    ),
                    "highlighting": highlighting,
                }
            )

        # =====================================================
        # BEST MATCH HIGHLIGHTING
        # =====================================================

        best_reference_sentence = (
            best_match.reference_sentence
        )

        best_reference_text = (
            best_reference_sentence.raw_text
            if best_reference_sentence
            else best_match.reference_text
        )

        best_highlighting = (
            generate_highlighting(
                scan_text=(
                    scan_sentence.raw_text
                ),
                reference_text=(
                    best_reference_text or ""
                ),
            )
        )

        best_source = None

        if (
            best_reference_sentence
            and best_reference_sentence
            .reference_document
        ):
            best_source = (
                best_reference_sentence
                .reference_document
                .title
            )

        # =====================================================
        # ADD MATCHED SENTENCE
        # =====================================================

        sentence_results.append(
            {
                "sentence_id": sentence_id,
                "sentence_index": (
                    scan_sentence.sentence_index
                ),
                "page_number": (
                    scan_sentence.page.page_number
                    if scan_sentence.page
                    else None
                ),
                "text": (
                    scan_sentence.raw_text
                ),
                "normalized_text": (
                    scan_sentence.normalized_text
                ),
                "token_count": (
                    scan_sentence.token_count
                ),
                **section_metadata,
                "matched": True,
                "match_count": len(
                    match_results
                ),
                "best_match": {
                    "match_id": str(
                        best_match.id
                    ),
                    "match_type": (
                        best_match.detection_method
                    ),
                    "similarity_score": (
                        float(
                            best_match.similarity_score
                        )
                        if best_match.similarity_score
                        is not None
                        else 0.0
                    ),
                    "source": best_source,
                    "reference_page_number": (
                        best_reference_sentence.page_number
                        if best_reference_sentence
                        else best_match.reference_page_number
                    ),
                    "reference_text": (
                        best_reference_text
                    ),
                    "highlighting": (
                        best_highlighting
                    ),
                },
                "matches": match_results,
                "highlighting": (
                    best_highlighting
                ),
            }
        )

    # =========================================================
    # 8. Calculate summary counts
    # =========================================================

    total_sentences = len(
        sentence_results
    )

    matched_sentences = sum(
        1
        for sentence in sentence_results
        if sentence["matched"]
    )

    unmatched_sentences = (
        total_sentences
        - matched_sentences
    )

    sentence_coverage = (
        (
            matched_sentences
            / total_sentences
        )
        * 100
        if total_sentences
        else 0.0
    )

    # =========================================================
    # 9. Return response
    # =========================================================

    return {
        "scan_id": str(
            scan.id
        ),
        "analysis_id": str(
            analysis.id
        ),
        "status": analysis.status,
        "total_sentences": (
            total_sentences
        ),
        "matched_sentences": (
            matched_sentences
        ),
        "unmatched_sentences": (
            unmatched_sentences
        ),
        "sentence_coverage_percentage": round(
            sentence_coverage,
            2,
        ),
        "sentences": sentence_results,
    }

@router.get(
    "/{scan_id}/plagiarism/compare",
    response_model=PlagiarismCompareResponse,
)
def compare_plagiarism_content(
    scan_id: str,
    reference_document_id: str | None = None,
    db: Session = Depends(get_db),
    current_user: User = Depends(
        require_roles("ADMIN", "INSTRUCTOR")
    ),
):
    # --------------------------------------------------------
    # Validate scan UUID
    # --------------------------------------------------------

    try:
        scan_uuid = UUID(scan_id)
    except ValueError:
        raise HTTPException(
            status_code=400,
            detail="Invalid scan_id.",
        )

    # --------------------------------------------------------
    # Find scan
    # --------------------------------------------------------

    scan = (
        db.query(Scan)
        .filter(
            Scan.id == scan_uuid
        )
        .first()
    )

    if not scan:
        raise HTTPException(
            status_code=404,
            detail="Scan not found.",
        )

    # --------------------------------------------------------
    # Check access
    # --------------------------------------------------------

    if not can_access_scan(
        db=db,
        scan=scan,
        current_user=current_user,
    ):
        raise HTTPException(
            status_code=403,
            detail="You are not allowed to access this scan.",
        )

    # --------------------------------------------------------
    # Find completed analysis
    # --------------------------------------------------------

    analysis = (
        db.query(PlagiarismAnalysis)
        .filter(
            PlagiarismAnalysis.scan_id == scan.id,
            PlagiarismAnalysis.status == "COMPLETED",
        )
        .order_by(
            PlagiarismAnalysis.created_at.desc()
        )
        .first()
    )

    if not analysis:
        raise HTTPException(
            status_code=404,
            detail="Completed plagiarism analysis not found.",
        )

    # --------------------------------------------------------
    # Validate optional reference document
    # --------------------------------------------------------

    reference_uuid = None

    if reference_document_id:
        try:
            reference_uuid = UUID(
                reference_document_id
            )
        except ValueError:
            raise HTTPException(
                status_code=400,
                detail="Invalid reference_document_id.",
            )

        reference_exists = (
            db.query(ReferenceDocument)
            .filter(
                ReferenceDocument.id
                == reference_uuid
            )
            .first()
        )

        if not reference_exists:
            raise HTTPException(
                status_code=404,
                detail="Reference document not found.",
            )

    # --------------------------------------------------------
    # Load plagiarism matches
    # --------------------------------------------------------

    query = (
        db.query(
            PlagiarismMatch,
            ReferenceDocument,
        )
        .join(
            ScanSentence,
            PlagiarismMatch.scan_sentence_id == ScanSentence.id,
        )
        .join(
            ReferenceDocument,
            PlagiarismMatch.reference_document_id
            == ReferenceDocument.id,
        )
        .options(
            joinedload(PlagiarismMatch.scan_sentence)
            .joinedload(ScanSentence.section)
            .joinedload(ScanSection.parent_section),
        )
        .filter(
            PlagiarismMatch.analysis_id
            == analysis.id,
            ScanSentence.scan_id == scan.id,
        )
    )

    if reference_uuid:
        query = query.filter(
            PlagiarismMatch.reference_document_id
            == reference_uuid
        )

    rows = (
        query
        .order_by(
            PlagiarismMatch.scan_sentence_id,
            PlagiarismMatch.similarity_score.desc(),
        )
        .all()
    )

    # --------------------------------------------------------
    # Build reference document summary
    # --------------------------------------------------------

    reference_map = {}

    for match, reference in rows:
        reference_id = str(
            reference.id
        )

        if reference_id not in reference_map:
            reference_map[reference_id] = {
                "id": reference_id,
                "title": reference.title,
                "file_name": reference.file_name,
                "match_count": 0,
            }

        reference_map[
            reference_id
        ]["match_count"] += 1

    # --------------------------------------------------------
    # Build comparison matches
    # --------------------------------------------------------

    comparison_matches = []

    for match, reference in rows:
        scan_section = (
            match.scan_sentence.section
            if match.scan_sentence
            else None
        )
        parent_section = (
            scan_section.parent_section
            if scan_section
            else None
        )

        comparison_matches.append(
            CompareMatchResponse(
                match_id=str(match.id),
                reference_document_id=str(reference.id),
                reference_title=reference.title,
                reference_file_name=reference.file_name,

                sentence_index=(
                    match.scan_sentence.sentence_index
                    if match.scan_sentence
                    else 0
                ),
                section_title=(
                    parent_section.section_title
                    if parent_section
                    else scan_section.section_title
                    if scan_section
                    else None
                ),
                paragraph_title=(
                    scan_section.section_title
                    if scan_section
                    else None
                ),

                scan_page_number=(
                    match.scan_page_number
                ),

                reference_page_number=(
                    match.reference_page_number
                ),

                match_type=(
                    match.detection_method
                ),

                similarity_score=(
                    float(match.similarity_score)
                ),

                scan_text=match.scan_text,

                reference_text=(
                    match.reference_text
                ),

                scan_highlighting={},

                reference_highlighting={},
            )
        )

    # --------------------------------------------------------
    # Return response
    # --------------------------------------------------------

    return PlagiarismCompareResponse(
        scan_id=str(scan.id),
        analysis_id=str(analysis.id),

        scan_title=scan.title,
        scan_file_name=scan.file_name,

        reference_documents=[
            CompareReferenceDocumentResponse(
                **item
            )
            for item in reference_map.values()
        ],

        matches=comparison_matches,
    )

