@router.get("/{scan_id}/document")
def view_scan_document(
    scan_id: UUID,
    db: Session = Depends(get_db),
    current_user: User = Depends(
        require_roles("ADMIN", "INSTRUCTOR")
    ),
):
    """Serve the original uploaded PDF inline."""

    scan = (
        db.query(Scan)
        .filter(Scan.id == scan_id)
        .first()
    )

    if scan is None:
        raise HTTPException(
            status_code=404,
            detail="Scan not found.",
        )

    file_path = Path(scan.file_path).resolve()

    if not file_path.is_file():
        raise HTTPException(
            status_code=404,
            detail="Original document file not found.",
        )

    if file_path.suffix.lower() != ".pdf":
        raise HTTPException(
            status_code=415,
            detail="Inline document viewing is supported for PDF files only.",
        )

    return FileResponse(
        path=str(file_path),
        media_type="application/pdf",
        content_disposition_type="inline",
        headers={
            "X-Content-Type-Options": "nosniff",
            "Cache-Control": "private, no-store",
        },
    )

