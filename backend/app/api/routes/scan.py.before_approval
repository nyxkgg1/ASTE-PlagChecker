# ============================================================
# GET PLAGIARISM RESULT
# ============================================================

@router.get(
    "/{scan_id}/plagiarism",
    response_model=PlagiarismResultResponse,
)
def get_plagiarism_result(
    scan_id: UUID,
    db: Session = Depends(get_db),
    current_user: User = Depends(
        require_roles(
            "ADMIN",
            "INSTRUCTOR",
        )
    ),
):
    """
    Return the plagiarism result for a scan.
    """

    # --------------------------------------------------------
    # Find scan
    # --------------------------------------------------------

    scan = (
        db.query(Scan)
        .filter(
            Scan.id == scan_id
        )
        .first()
    )

    if not scan:
        raise HTTPException(
            status_code=404,
            detail="Scan not found.",
        )

    # --------------------------------------------------------
    # Access check
    # --------------------------------------------------------

    if not can_access_scan(
        db,
        scan,
        current_user,
    ):
        raise HTTPException(
            status_code=403,
            detail="You do not have permission to access this scan.",
        )

    # --------------------------------------------------------
    # Find latest analysis
    # --------------------------------------------------------

    analysis = (
        db.query(PlagiarismAnalysis)
        .filter(
            PlagiarismAnalysis.scan_id == scan.id
        )
        .order_by(
            PlagiarismAnalysis.created_at.desc()
        )
        .first()
    )

    if not analysis:
        raise HTTPException(
            status_code=404,
            detail="Plagiarism analysis not found.",
        )

    # --------------------------------------------------------
    # Load all scan sentences
    # --------------------------------------------------------

    sentences = (
        db.query(ScanSentence)
        .filter(
            ScanSentence.scan_id == scan.id
        )
        .order_by(
            ScanSentence.sentence_index
        )
        .all()
    )

    # --------------------------------------------------------
    # Load plagiarism matches
    # --------------------------------------------------------

    match_rows = (
        db.query(
            PlagiarismMatch,
            ScanSentence,
            ReferenceDocument,
        )
        .join(
            ScanSentence,
            ScanSentence.id
            == PlagiarismMatch.scan_sentence_id,
        )
        .join(
            ReferenceDocument,
            ReferenceDocument.id
            == PlagiarismMatch.reference_document_id,
        )
        .filter(
            PlagiarismMatch.analysis_id
            == analysis.id
        )
        .all()
    )

    # --------------------------------------------------------
    # Build match response
    # --------------------------------------------------------

    matches = []

    for (
        match,
        sentence,
        reference_document,
    ) in match_rows:

        matches.append(
            PlagiarismMatchResponse(
                id=str(match.id),
                sentence_index=sentence.sentence_index,
                scan_page_number=match.scan_page_number,
                match_type=(
                    match.detection_method
                    or "UNKNOWN"
                ),
                similarity_score=float(
                    match.similarity_score
                ),
                source=reference_document.title,
                reference_page_number=(
                    match.reference_page_number
                ),
                scan_text=match.scan_text,
                reference_text=match.reference_text,
            )
        )

    # --------------------------------------------------------
    # Unique matched sentences
    # --------------------------------------------------------

    matched_sentence_ids = {
        match.scan_sentence_id
        for match, _, _ in match_rows
    }

    matched_sentences = [
        sentence
        for sentence in sentences
        if sentence.id in matched_sentence_ids
    ]

    # --------------------------------------------------------
    # Unmatched sentences
    # --------------------------------------------------------

    unmatched_sentences = [
        UnmatchedSentenceResponse(
            sentence_index=sentence.sentence_index,
            scan_page_number=(
                sentence.page.page_number
                if sentence.page
                else None
            ),
            text=sentence.raw_text,
            token_count=sentence.token_count,
        )
        for sentence in sentences
        if sentence.id not in matched_sentence_ids
    ]

    # --------------------------------------------------------
    # Sentence statistics
    # --------------------------------------------------------

    total_sentence_count = len(
        sentences
    )

    matched_sentence_count = len(
        matched_sentences
    )

    unmatched_sentence_count = (
        total_sentence_count
        - matched_sentence_count
    )

    if total_sentence_count:
        sentence_coverage = (
            matched_sentence_count
            / total_sentence_count
        ) * 100
    else:
        sentence_coverage = 0.0

    # --------------------------------------------------------
    # Text coverage
    # --------------------------------------------------------

    total_text_length = sum(
        len(sentence.raw_text or "")
        for sentence in sentences
    )

    matched_text_length = sum(
        len(sentence.raw_text or "")
        for sentence in matched_sentences
    )

    if total_text_length:
        text_coverage = (
            matched_text_length
            / total_text_length
        ) * 100
    else:
        text_coverage = 0.0

    # --------------------------------------------------------
    # Best match score per sentence
    # --------------------------------------------------------

    best_match_by_sentence = {}

    for (
        match,
        sentence,
        _,
    ) in match_rows:

        score = float(
            match.similarity_score
        )

        existing = best_match_by_sentence.get(
            sentence.id
        )

        if (
            existing is None
            or score > existing
        ):
            best_match_by_sentence[
                sentence.id
            ] = score

    if best_match_by_sentence:

        average_match_strength = (
            sum(
                best_match_by_sentence.values()
            )
            / len(best_match_by_sentence)
        )

    else:

        average_match_strength = 0.0

    # --------------------------------------------------------
    # Match classification per sentence
    # --------------------------------------------------------

    best_type_by_sentence = {}

    priority = {
        "EXACT": 4,
        "STRONG_TEXTUAL_MATCH": 3,
        "HIGH_SIMILARITY": 2,
        "MODERATE_SIMILARITY": 1,
        "LOW_SIMILARITY": 0,
    }

    for (
        match,
        sentence,
        _,
    ) in match_rows:

        match_type = (
            match.detection_method
            or "LOW_SIMILARITY"
        )

        existing = best_type_by_sentence.get(
            sentence.id
        )

        if (
            existing is None
            or priority.get(
                match_type,
                0,
            )
            > priority.get(
                existing,
                0,
            )
        ):

            best_type_by_sentence[
                sentence.id
            ] = match_type

    # --------------------------------------------------------
    # Match counts
    # --------------------------------------------------------

    exact_count = sum(
        1
        for match_type
        in best_type_by_sentence.values()
        if match_type == "EXACT"
    )

    high_similarity_count = sum(
        1
        for match_type
        in best_type_by_sentence.values()
        if match_type == "HIGH_SIMILARITY"
    )

    moderate_similarity_count = sum(
        1
        for match_type
        in best_type_by_sentence.values()
        if match_type == "MODERATE_SIMILARITY"
    )

    low_similarity_count = sum(
        1
        for match_type
        in best_type_by_sentence.values()
        if match_type == "LOW_SIMILARITY"
    )

    # --------------------------------------------------------
    # Statistics response
    # --------------------------------------------------------

    statistics = (
        PlagiarismStatisticsResponse(
            total_sentences=total_sentence_count,
            matched_sentences=matched_sentence_count,
            unmatched_sentences=unmatched_sentence_count,
            sentence_coverage_percentage=round(
                sentence_coverage,
                2,
            ),
            text_coverage_percentage=round(
                text_coverage,
                2,
            ),
            average_match_strength=round(
                average_match_strength,
                2,
            ),
        )
    )

    # --------------------------------------------------------
    # Algorithm scores
    # --------------------------------------------------------

    algorithm_scores = (
        PlagiarismAlgorithmScoresResponse(
            exact=(
                float(
                    analysis.exact_match_score
                )
                if analysis.exact_match_score
                is not None
                else None
            ),
            ngram=(
                float(
                    analysis.ngram_score
                )
                if analysis.ngram_score
                is not None
                else None
            ),
            tfidf=(
                float(
                    analysis.tfidf_score
                )
                if analysis.tfidf_score
                is not None
                else None
            ),
            semantic=(
                float(
                    analysis.semantic_score
                )
                if analysis.semantic_score
                is not None
                else None
            ),
            cross_encoder=(
                float(
                    analysis.cross_encoder_score
                )
                if analysis.cross_encoder_score
                is not None
                else None
            ),
        )
    )

    # --------------------------------------------------------
    # Match counts response
    # --------------------------------------------------------

    match_counts = (
        PlagiarismMatchCountsResponse(
            exact=exact_count,
            high_similarity=high_similarity_count,
            moderate_similarity=moderate_similarity_count,
            low_similarity=low_similarity_count,
        )
    )

    # --------------------------------------------------------
    # Return result
    # --------------------------------------------------------

    return PlagiarismResultResponse(
        scan_id=str(scan.id),
        analysis_id=str(analysis.id),
        status=analysis.status,
        overall_similarity=(
            float(
                analysis.overall_similarity
            )
            if analysis.overall_similarity
            is not None
            else None
        ),
        statistics=statistics,
        algorithm_scores=algorithm_scores,
        match_counts=match_counts,
        matches=matches,
        unmatched_sentences=unmatched_sentences,
    )


