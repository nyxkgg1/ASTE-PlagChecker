        current_user=current_user,
    ):
        raise HTTPException(
            status_code=403,
            detail="You do not have access to this scan.",
        )

    # --------------------------------------------------------
    # Verify scan completed
    # --------------------------------------------------------

    if scan.status != "COMPLETED":
        raise HTTPException(
            status_code=400,
            detail=(
                "Certificate can only be generated "
                "for a completed scan."
            ),
        )

    # --------------------------------------------------------
    # Check whether certificate already exists
    # --------------------------------------------------------

    existing = (
        db.query(Certificate)
        .filter(
            Certificate.scan_id == scan.id
        )
        .first()
    )

    if existing:
        return CertificateResponse(
            id=str(existing.id),
            scan_id=str(existing.scan_id),
            certificate_number=(
                existing.certificate_number
            ),
            certificate_path=(
                existing.certificate_path
            ),
            generated_at=(
                existing.generated_at.isoformat()
            ),
            generated_by=(
                str(existing.generated_by)
            ),
            certificate_hash=(
                existing.certificate_hash
            ),
            status=existing.status,
        )

    # --------------------------------------------------------
    # Generate certificate
    # --------------------------------------------------------

    try:
        certificate = create_certificate(
            db=db,
            scan=scan,
            generated_by=current_user,
        )

    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=str(exc),
        )

    except Exception:
        db.rollback()

        raise HTTPException(
            status_code=500,
            detail="Certificate generation failed.",
        )

    # --------------------------------------------------------
    # Audit
    # --------------------------------------------------------

    create_audit_log(
        db=db,
        user_id=current_user.id,
        action="CERTIFICATE_GENERATED",
        entity_type="CERTIFICATE",
        entity_id=certificate.id,
        new_values={
            "scan_id": str(scan.id),
            "certificate_number": (
                certificate.certificate_number
            ),
            "certificate_hash": (
                certificate.certificate_hash
            ),
        },
    )

    db.commit()
    db.refresh(certificate)

    return CertificateResponse(
        id=str(certificate.id),
        scan_id=str(certificate.scan_id),
        certificate_number=(
            certificate.certificate_number
        ),
        certificate_path=(
            certificate.certificate_path
        ),
        generated_at=(
            certificate.generated_at.isoformat()
        ),
        generated_by=(
            str(certificate.generated_by)
        ),
        certificate_hash=(
            certificate.certificate_hash
        ),
        status=certificate.status,
    )

# ============================================================
# DOWNLOAD CERTIFICATE
# ============================================================

@router.get(
    "/{scan_id}/certificate/download",
)
def download_scan_certificate(
    scan_id: str,
    db: Session = Depends(get_db),
    current_user: User = Depends(
        require_roles(
            "ADMIN",
            "INSTRUCTOR",
        )
    ),
):
    # --------------------------------------------------------
    # Validate UUID
    # --------------------------------------------------------

    try:
        scan_uuid = UUID(scan_id)

    except ValueError:
        raise HTTPException(
            status_code=400,
            detail="Invalid scan_id.",
        )

    # --------------------------------------------------------
    # Find scan
    # --------------------------------------------------------

    scan = (
        db.query(Scan)
        .filter(
            Scan.id == scan_uuid
        )
        .first()
    )

    if not scan:
        raise HTTPException(
            status_code=404,
            detail="Scan not found.",
        )

    # --------------------------------------------------------
    # Access control
    # --------------------------------------------------------

    if not can_access_scan(
        db=db,
        scan=scan,
        current_user=current_user,
    ):
        raise HTTPException(
            status_code=403,
            detail="You do not have access to this scan.",
        )

    # --------------------------------------------------------
    # Find certificate
    # --------------------------------------------------------

    certificate = (
        db.query(Certificate)
        .filter(
            Certificate.scan_id == scan.id
        )
        .first()
    )

    if not certificate:
        raise HTTPException(
            status_code=404,
            detail=(
                "Certificate has not been generated "
                "for this scan."
            ),
        )

    # --------------------------------------------------------
    # Verify physical file
    # --------------------------------------------------------

    certificate_path = Path(
        certificate.certificate_path
    )

    if not certificate_path.exists():
        raise HTTPException(
            status_code=404,
            detail="Certificate file not found.",
        )

    # --------------------------------------------------------
    # Return PDF
    # --------------------------------------------------------

    return FileResponse(
        path=str(certificate_path),
        media_type="application/pdf",
        filename=(
            f"{certificate.certificate_number}.pdf"
        ),
    )