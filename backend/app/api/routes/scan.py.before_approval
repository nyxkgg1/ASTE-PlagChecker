def get_user_roles(
    db: Session,
    user: User,
) -> list[str]:
    """
    Return role names assigned to the user.
    """

    user_roles = (
        db.query(UserRole)
        .filter(
            UserRole.user_id == user.id
        )
        .all()
    )

    return [
        user_role.role.role_name
        for user_role in user_roles
        if user_role.role is not None
    ]

def can_access_scan(
    db: Session,
    scan: Scan,
    current_user: User,
) -> bool:
    """
    Determine whether the current user can access a scan.

    ADMIN:
        Can access all scans.

    INSTRUCTOR:
        Can access all scans.

    STUDENT_OFFICER:
        Can access only their own scans.
    """

    roles = get_user_roles(
        db=db,
        user=current_user,
    )

    if "ADMIN" in roles:
        return True

    if "INSTRUCTOR" in roles:
        return True

    if "STUDENT_OFFICER" in roles:
        return scan.owner_id == current_user.id

    return False

def build_scan_response(
    scan: Scan,
) -> ScanResponse:
    """
    Convert Scan database object into ScanResponse.
    """

    return ScanResponse(
        id=str(scan.id),
        title=scan.title,
        file_name=scan.file_name,
        file_size=scan.file_size,
        mime_type=scan.mime_type,
        sha256_hash=scan.sha256_hash,
        status=scan.status,
        owner_id=(
            str(scan.owner_id)
            if scan.owner_id
            else None
        ),
        scanned_by=str(scan.scanned_by),
        created_at=scan.created_at.isoformat(),
        completed_at=(
            scan.completed_at.isoformat()
            if scan.completed_at
            else None
        ),
    )


# ============================================================
# LIST SCANS
# ============================================================


@router.get("")
def list_scans(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    """List scans visible to the logged-in user."""
    roles = get_user_roles(db=db, user=current_user)

    query = db.query(Scan)

    if "ADMIN" not in roles and "INSTRUCTOR" not in roles:
        if "STUDENT_OFFICER" not in roles:
            raise HTTPException(
                status_code=403,
                detail="You do not have permission to view scans.",
            )

        query = query.filter(Scan.owner_id == current_user.id)

    scans = query.order_by(Scan.created_at.desc()).all()
    results = []

    for scan in scans:
        item = build_scan_response(scan).dict()

        # Certificate information
        certificate = (
            db.query(Certificate)
            .filter(Certificate.scan_id == scan.id)
            .first()
        )

        item["certificate_generated"] = certificate is not None
        item["certificate_number"] = (
            certificate.certificate_number if certificate else None
        )
        item["certificate_id"] = (
            str(certificate.id) if certificate else None
        )

        # Approval fields are not yet connected to an identified
        # approval record in the database.
        item["admin_approval_date"] = None
        item["approval_status"] = None

        # Latest plagiarism analysis
        analysis = (
            db.query(PlagiarismAnalysis)
            .filter(PlagiarismAnalysis.scan_id == scan.id)
            .order_by(
                PlagiarismAnalysis.created_at.desc(),
                PlagiarismAnalysis.id.desc(),
            )
            .first()
        )

        similarity = (
            float(analysis.overall_similarity)
            if analysis and analysis.overall_similarity is not None
            else None
        )

        # The UI expects a percentage. Convert fractional scores
        # such as 0.25 to 25, but preserve scores already in 0–100.
        if similarity is not None and 0 <= similarity <= 1:
            similarity *= 100

        item["plagiarism_score"] = similarity
        item["ai_score"] = None

        results.append(item)

    return results


# ============================================================
# CREATE SCAN
# ============================================================

@router.post(
    "",
    response_model=ScanResponse,
)
async def create_scan(
    title: str = Form(...),
    document: UploadFile = File(...),
    destination_folder: str = Form(""),
    db: Session = Depends(get_db),
    current_user: User = Depends(
        require_roles(
            "ADMIN",
            "INSTRUCTOR",
        )
    ),
):
    """
    Upload a document, extract its contents,
    create scan sentences and run plagiarism analysis.
    """

    # --------------------------------------------------------
    # Save uploaded file
    # --------------------------------------------------------

    try:
        (
            file_path,
            file_size,
            sha256_hash,
            extension,
        ) = await save_scan_file(
                document,
                destination_folder=destination_folder,
            )

    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=str(exc),
        )

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Failed to save uploaded document: {exc}",
        )

    # --------------------------------------------------------
    # Determine MIME type
    # --------------------------------------------------------

    mime_type = (
        document.content_type
        or "application/octet-stream"
    )

    # --------------------------------------------------------
    # Create Scan record
    # --------------------------------------------------------

    scan = Scan(
        title=title,
        file_name=document.filename or f"document{extension}",
        file_path=str(file_path),
        file_size=file_size,
        mime_type=mime_type,
        sha256_hash=sha256_hash,
        status="PROCESSING",
        owner_id=current_user.id,
        scanned_by=current_user.id,
    )

    db.add(scan)

    try:
        db.flush()

        # ----------------------------------------------------
        # Extract document pages
        # ----------------------------------------------------

        processed_pages = process_extracted_pages(
            file_path
        )

        # ----------------------------------------------------
        # Create pages and sentences
        # ----------------------------------------------------

        for processed_page in processed_pages:

            scan_page = ScanPage(
                scan_id=scan.id,
                page_number=processed_page[
                    "page_number"
                ],
                raw_text=processed_page[
                    "raw_text"
                ],
                #normalized_text=processed_page[
                   # "normalized_text"
                #],
            )

            db.add(scan_page)

            db.flush()

            # ------------------------------------------------
            # Process sentences on this page
            # ------------------------------------------------

            sentences = process_page_sentences(
                processed_page[
                    "normalized_text"
                ]
            )

            for sentence_data in sentences:

                scan_sentences = ScanSentence(
                    scan_id=scan.id,
                    page_id=scan_page.id,
                    sentence_index=sentence_data["sentence_index"],
                    raw_text=sentence_data["raw_text"],
                    normalized_text=sentence_data["normalized_text"],
                    token_count=sentence_data["token_count"],
                )

                db.add(scan_sentences)

        db.flush()

        # ----------------------------------------------------
        # Run plagiarism analysis
        # ----------------------------------------------------

        analysis = save_plagiarism_analysis(
            db=db,
            scan_id=scan.id,
            initiated_by=current_user.id,
        )

        # ----------------------------------------------------
        # Mark scan completed
        # ----------------------------------------------------

        scan.status = "COMPLETED"

        scan.completed_at = datetime.now(
            timezone.utc
        )

        # ----------------------------------------------------
        # Audit log
        # ----------------------------------------------------

        create_audit_log(
            db=db,
            user_id=current_user.id,
            action="SCAN_CREATED",
            entity_type="SCAN",
            entity_id=scan.id,
            new_values={
                "title": scan.title,
                "file_name": scan.file_name,
            },
        )

        # ----------------------------------------------------
        # Commit transaction
        # ----------------------------------------------------

        db.commit()

        db.refresh(scan)

        return build_scan_response(scan)

    except Exception as exc:

        db.rollback()

        # ----------------------------------------------------
        # Delete uploaded file if processing failed
        # ----------------------------------------------------

        try:
            if Path(file_path).exists():
                Path(file_path).unlink()
        except Exception:
            pass

        raise HTTPException(
            status_code=500,
            detail=f"Failed to process scan: {exc}",
        )


